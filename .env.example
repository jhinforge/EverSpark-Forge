# Default local-first behavior
EVERSPARK_STORAGE_BACKEND=local
EVERSPARK_NETWORK_BACKEND=local
EVERSPARK_LOG_DIR=./Data/Logs

# Optional rclone/R2 storage backend
RCLONE_CONFIG=
IMAGE_FORGE_RCLONE_REMOTE=
CONCEPT_FORGE_RCLONE_REMOTE=

# Optional Cloudflare Named Tunnel backend
CF_TUNNEL_UUID=
CF_TUNNEL_NAME=
CF_HOSTNAME=
CF_LOCAL_PORT=8780
CF_CREDENTIAL_SOURCE=

# Optional model and execution endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=everspark-concept
COMFYUI_BASE_URL=http://127.0.0.1:8188
EVERSPARK_OLLAMA_HOST=127.0.0.1:11434
EVERSPARK_IMAGE_FORGE_HOST=127.0.0.1
EVERSPARK_IMAGE_FORGE_PORT=8188
OLLAMA_KEEP_ALIVE=0

# Optional managed-runtime version overrides
EVERSPARK_COMFYUI_VERSION=v0.37.0
EVERSPARK_COMFYUI_COMMIT=73c9bad4d21e7addbe1d13bc92eee0f1431b017d
EVERSPARK_OLLAMA_VERSION=0.34.2
EVERSPARK_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# Optional WebUI endpoint overrides
EVERSPARK_WEBUI_HOST=127.0.0.1
EVERSPARK_WEBUI_PORT=8780
# Optional SSH access overrides. Vast.ai normally supplies PUBLIC_IPADDR and
# VAST_TCP_PORT_22 automatically, so these can remain empty there.
EVERSPARK_SSH_HOST=
EVERSPARK_SSH_PORT=
EVERSPARK_SSH_USER=root
EVERSPARK_LOCAL_WEBUI_PORT=8080
EVERSPARK_ORCHESTRATOR_URL=http://127.0.0.1:8765
EVERSPARK_IMAGE_FORGE_URL=http://127.0.0.1:8188

# Optional Orchestrator and local Memory overrides
EVERSPARK_ORCHESTRATOR_HOST=127.0.0.1
EVERSPARK_ORCHESTRATOR_PORT=8765
EVERSPARK_MEMORY_DATABASE=./Data/Memory/everspark.db
EVERSPARK_WORKFLOW_TEMPLATE=./ImageForge/Workflows/base_workflow_api.json

# Optional multi-GPU assignment overrides
IMAGE_FORGE_GPU_INDEX=0
CONCEPT_FORGE_GPU_INDEX=1
