# Default local-first behavior
EVERSPARK_STORAGE_BACKEND=local
EVERSPARK_NETWORK_BACKEND=local
EVERSPARK_LOG_DIR=./Data/Logs

# Optional rclone/R2 storage backend
RCLONE_CONFIG=
IMAGE_FORGE_RCLONE_REMOTE=
CONCEPT_FORGE_RCLONE_REMOTE=

# Optional Cloudflare Named Tunnel backend
CF_TUNNEL_UUID=
CF_TUNNEL_NAME=
CF_HOSTNAME=
CF_LOCAL_PORT=8780
CF_CREDENTIAL_SOURCE=

# Optional model and execution endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Optional multi-GPU assignment overrides
IMAGE_FORGE_GPU_INDEX=0
CONCEPT_FORGE_GPU_INDEX=1
